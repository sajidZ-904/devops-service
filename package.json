{
  "name": "devops-service-task",
  "version": "1.0.0",
  "description": "Node.js DevOps monitoring service",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src tests",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/config.js",
      "!src/logger.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "aws-cli-js": "^2.2.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
